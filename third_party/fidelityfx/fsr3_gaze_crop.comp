#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8)in;
layout(set=0,binding=0)uniform texture2D fullColor;
layout(set=0,binding=1)uniform texture2D fullDepth;
layout(set=0,binding=2)uniform texture2D fullMotion;
layout(set=0,binding=3,rgba16f)writeonly uniform image2D cropColor;
layout(set=0,binding=4,r32f)writeonly uniform image2D cropDepth;
layout(set=0,binding=5,rg16f)writeonly uniform image2D cropMotion;
layout(push_constant)uniform Constants {
  ivec2 fullSize;
  ivec2 cropSize;
  ivec2 origin;
  ivec2 previousOrigin;
  uint nativeMotion;
  uint reserved0;
  uint reserved1;
  uint reserved2;
} parameters;
void main(){
  ivec2 local=ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(local,parameters.cropSize)))return;
  ivec2 source=clamp(parameters.origin+local,ivec2(0),parameters.fullSize-1);
  imageStore(cropColor,local,texelFetch(fullColor,source,0));
  imageStore(cropDepth,local,vec4(texelFetch(fullDepth,source,0).r));
  vec2 motion=vec2(0);
  if(parameters.nativeMotion!=0u){
    // Native motion is current-minus-previous clip NDC, with raster Y flipped.
    // previousLocal-currentLocal = previousFull-currentFull + currentOrigin-previousOrigin.
    motion=texelFetch(fullMotion,source,0).xy*vec2(-.5,.5)*vec2(parameters.fullSize)
        +vec2(parameters.origin-parameters.previousOrigin);
  }
  imageStore(cropMotion,local,vec4(motion,0,0));
}
